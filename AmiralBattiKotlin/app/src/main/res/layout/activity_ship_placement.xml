<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvPlacementTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gemi Yerleştirme"
            android:textStyle="bold"
            android:textSize="28sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvCurrentShip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seçili gemi: -"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvOrientation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yön: Yatay"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnRotate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yönü Değiştir"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnResetBoard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tahtayı Sıfırla"
            android:layout_marginBottom="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBoard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvPlacementStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Durum: Gemileri yerleştir"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnReady"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hazırım"
            android:enabled="false" />

    </LinearLayout>
</ScrollView>