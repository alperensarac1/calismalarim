<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/anticipate_overshoot">
    <scale
        android:fromXScale="1.0" android:toXScale="0.92"
        android:fromYScale="1.0" android:toYScale="0.92"
        android:pivotX="50%" android:pivotY="50%"
        android:duration="70"/>
    <scale
        android:fromXScale="0.92" android:toXScale="1.04"
        android:fromYScale="0.92" android:toYScale="1.04"
        android:pivotX="50%" android:pivotY="50%"
        android:startOffset="70"
        android:duration="90"/>
    <scale
        android:fromXScale="1.04" android:toXScale="1.0"
        android:fromYScale="1.04" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%"
        android:startOffset="160"
        android:duration="80"/>
</set>
