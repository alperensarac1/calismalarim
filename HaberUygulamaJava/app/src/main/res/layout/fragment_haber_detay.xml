<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".view.HaberDetayFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvHaberBaslik"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keklikler Savaşta"
                android:textSize="24sp"
                android:textColor="#707070"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginTop="24sp"
                android:layout_marginLeft="24sp"/>

            <FrameLayout
                android:id="@+id/frResimVideo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvHaberBaslik"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">

                <!-- Görsel için ImageView -->
                <ImageView
                    android:id="@+id/imgHaber"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:src="@drawable/resim"
                    android:scaleType="centerCrop"
                    android:visibility="visible" />

                <!-- Video için VideoView -->
                <VideoView
                    android:id="@+id/videoView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:visibility="gone" />

                <!-- Oynat butonu sadece video için -->
                <ImageButton
                    android:id="@+id/btnPlay"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:src="@android:drawable/ic_media_play"
                    android:visibility="gone"
                    android:contentDescription="Oynat" />
            </FrameLayout>


            <TextView
                android:id="@+id/tvAdSoyadDepartman"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Berna Bulgulu - Editör"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/frResimVideo"
                app:layout_constraintLeft_toLeftOf="@id/frResimVideo"
                android:layout_marginTop="8sp" />
            <TextView
                android:id="@+id/tvTarih"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21.06.2025"
                android:textSize="16sp"
                app:layout_constraintRight_toRightOf="@id/frResimVideo"
                app:layout_constraintTop_toTopOf="@id/tvAdSoyadDepartman"/>
            <TextView
                android:id="@+id/tvHaberIcerik"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:text="deneme"
                app:layout_constraintTop_toBottomOf="@id/tvAdSoyadDepartman"
                android:layout_marginTop="16dp"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvSonHaberler"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Son Haberler"
                android:textSize="24sp"
                android:textColor="#707070"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tvHaberIcerik"
                app:layout_constraintLeft_toLeftOf="@id/tvHaberIcerik"
                android:layout_marginTop="16dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSonUcHaber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tvSonHaberler"
                android:layout_margin="16dp"/>

            <TextView
                android:id="@+id/tvYorumYaz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:text="Yorum Yaz"
                android:textColor="#6640A3"
                app:layout_constraintTop_toBottomOf="@id/rvSonUcHaber"
                app:layout_constraintLeft_toLeftOf="@id/rvSonUcHaber"
                android:layout_marginTop="16dp"/>

            <EditText
                android:id="@+id/etRumuz"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tvYorumYaz"
                android:layout_marginTop="16dp"
                android:textSize="24sp"
                android:hint="Rumuz..."
                app:layout_constraintLeft_toLeftOf="@id/tvYorumYaz"/>
            <EditText
                android:id="@+id/etYorum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/etRumuz"
                android:layout_marginTop="16dp"
                android:textSize="24sp"
                android:hint="Yorumunuz..."
                android:layout_marginHorizontal="16dp"
                app:layout_constraintLeft_toLeftOf="@id/tvYorumYaz"/>
            <Button
                android:id="@+id/btnYorumGonder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:text="GÖNDER"
                android:textColor="#707070"
                android:backgroundTint="#C7EDE6"
                app:layout_constraintTop_toBottomOf="@id/etYorum"
                app:layout_constraintLeft_toLeftOf="@id/etYorum"
                android:layout_marginTop="24dp"/>

            <TextView
                android:id="@+id/tvYorumlar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:text="Yorumlar"
                android:textColor="#6640A3"
                app:layout_constraintTop_toBottomOf="@id/btnYorumGonder"
                app:layout_constraintLeft_toLeftOf="@id/btnYorumGonder"
                android:layout_marginTop="16dp"/>

            <ListView
                android:id="@+id/yorumlarListView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tvYorumlar"
                app:layout_constraintLeft_toLeftOf="@+id/tvYorumlar"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>


</LinearLayout>