<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="16dp"/>
            <gradient
                android:angle="0"
                android:startColor="#3730A3"
                android:endColor="#4F46E5"
                android:type="linear"/>
        </shape>
    </item>

    <!-- Disabled -->
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="16dp"/>
            <solid android:color="#D1D5DB"/>
        </shape>
    </item>

    <!-- Normal -->
    <item>
        <shape>
            <corners android:radius="16dp"/>
            <gradient
                android:angle="0"
                android:startColor="#4F46E5"
                android:endColor="#06B6D4"
                android:type="linear"/>
        </shape>
    </item>

</selector>
