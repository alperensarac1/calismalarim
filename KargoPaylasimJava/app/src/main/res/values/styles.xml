<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="H1">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="H2">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="BodyMuted">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <!-- Card -->
    <style name="AppCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">16dp</item>

        <!-- Premium stroke -->
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/stroke</item>
    </style>


    <!-- Buttons -->
    <style name="AppButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>

        <!-- Premium background -->
        <item name="android:background">@drawable/btn_primary_premium</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="AppButton.Secondary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>

        <item name="android:background">@drawable/btn_outlined_premium</item>
        <item name="android:textColor">@color/primary</item>
    </style>


    <!-- TextInput -->
    <style name="AppTextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>

        <item name="boxStrokeColor">@color/stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>

        <item name="hintTextColor">@color/muted</item>
    </style>


    <style name="AppTextInput" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

</resources>
