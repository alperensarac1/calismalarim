<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_register.xml

    Java + XML kayıt ekranı.

    Bu versiyonda TextInputLayout / TextInputEditText yok.
    Tamamen normal EditText kullanıyoruz.

    Alanlar:
    - Ad Soyad
    - E-posta
    - Telefon
    - Şifre
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvRegisterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Yeni Hesap Oluştur"
            android:textColor="#1E293B"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRegisterSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Etkinlik biletlerini kolayca satın almak için kayıt ol."
            android:textColor="#64748B"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kayıt Ol"
                android:textColor="#0F172A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Ad soyad -->
            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="#EEF2FF"
                android:hint="Ad Soyad"
                android:inputType="textPersonName"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#0F172A"
                android:textColorHint="#64748B"
                android:textSize="15sp" />

            <!-- E-posta -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="#EEF2FF"
                android:hint="E-posta"
                android:inputType="textEmailAddress"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#0F172A"
                android:textColorHint="#64748B"
                android:textSize="15sp" />

            <!-- Telefon -->
            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="#EEF2FF"
                android:hint="Telefon"
                android:inputType="phone"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#0F172A"
                android:textColorHint="#64748B"
                android:textSize="15sp" />

            <!-- Şifre -->
            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="#EEF2FF"
                android:hint="Şifre"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#0F172A"
                android:textColorHint="#64748B"
                android:textSize="15sp" />

            <!-- Kayıt butonu -->
            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#16A34A"
                android:text="Kayıt Ol"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Giriş ekranına dön -->
            <TextView
                android:id="@+id/tvGoLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Zaten hesabın var mı? Giriş yap"
                android:textColor="#2563EB"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Kayıt oluşturuluyor..."
            android:textColor="#64748B"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>