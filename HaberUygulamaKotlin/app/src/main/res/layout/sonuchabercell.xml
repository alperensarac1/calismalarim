<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:orientation="horizontal"
    android:padding="8dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/sonHaberCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="4dp"
        android:radius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Görsel Alanı -->
            <FrameLayout
                android:id="@+id/mediaContainer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp">

                <!-- ImageView (varsayılan resim gösterimi) -->
                <ImageView
                    android:id="@+id/imgHaber"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/resim" />

                <!-- VideoView (başlangıçta gizli) -->
                <VideoView
                    android:id="@+id/videoHaber"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <!-- Oynatma Butonu -->
                <ImageButton
                    android:id="@+id/btnPlay"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:src="@android:drawable/ic_media_play"
                    android:visibility="gone"
                    android:contentDescription="Oynat" />
            </FrameLayout>

            <!-- Metin Alanı -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/tvHaberBaslik"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Keklikler Savaşta..."
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvDevaminiOku"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Devamını Oku ->"
                    android:textColor="#6640A3"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:paddingStart="8dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
