<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".view.AnasayfaFragment">

    <TextView
        android:id="@+id/tvSonDakika"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SON DAKİKA"
        android:textColor="#C65555"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginLeft="24dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSonDakika"
        android:layout_width="0dp"
        android:layout_height="200dp"
        app:layout_constraintTop_toBottomOf="@id/tvSonDakika"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

    <TextView
        android:id="@+id/tvGundem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GÜNDEM"
        android:textColor="#C65555"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/rvSonDakika"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginLeft="24dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGundem"
        android:layout_width="0dp"
        android:layout_height="200dp"
        app:layout_constraintTop_toBottomOf="@id/tvGundem"
        android:layout_marginTop="24sp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

    <TextView
        android:id="@+id/tvKategoriler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KATEGORİLER"
        android:textColor="#C65555"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/rvGundem"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginLeft="24dp"/>
    <ListView
        android:id="@+id/lvKategoriler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvKategoriler"/>


</androidx.constraintlayout.widget.ConstraintLayout>