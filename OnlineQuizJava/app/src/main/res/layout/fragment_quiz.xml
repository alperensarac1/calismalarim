<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtQuizTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quiz"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#111827" />

        <TextView
            android:id="@+id/txtQuestionCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Soru bekleniyor..."
            android:textSize="15sp"
            android:textColor="#6B7280"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Süre:"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#DC2626"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/txtQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Soru burada görünecek."
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginTop="22dp" />

        <LinearLayout
            android:id="@+id/optionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="22dp" />

        <TextView
            android:id="@+id/txtAnswerResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:layout_marginTop="22dp" />

        <TextView
            android:id="@+id/txtScoreboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Puan tablosu bekleniyor..."
            android:textSize="15sp"
            android:textColor="#111827"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>

</ScrollView>