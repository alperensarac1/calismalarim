<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Kabul Ettiklerim"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvTimer"
            android:text="Kalan süre: --:--"
            android:layout_marginTop="8dp"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/box"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="10dp"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView android:id="@+id/tvPatient" android:text="Hasta: -" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvPhone" android:text="Telefon: -" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvService" android:text="Servis: -" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvRoom" android:text="Oda: -" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnDial"
            android:text="Ara"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvInfo"
            android:text="Hasta 5 dakika içinde onaylamazsa istek tekrar ilçedeki listeye düşer."
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>