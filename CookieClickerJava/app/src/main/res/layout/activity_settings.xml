<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:orientation="vertical"
    android:background="@drawable/gradient_bg">

    <TextView
        android:text="@string/settings_title"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swVibrate"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_vibrate"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swSound"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_sound"/>

    <TextView
        android:id="@+id/tvAutosaveLabel"
        android:layout_marginTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_autosave_time"/>

    <SeekBar
        android:id="@+id/seekAutosave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="120"
        android:min="5"/>

    <TextView
        android:id="@+id/tvAutosaveValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10 sn"/>

</LinearLayout>
