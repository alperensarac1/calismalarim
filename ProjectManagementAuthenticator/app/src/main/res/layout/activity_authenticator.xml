<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/authenticatorScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    tools:context=".presentation.authenticator.AuthenticatorActivity">

    <!--
        =====================================================
        AUTHENTICATOR ANA EKRANI
        =====================================================

        Bu ekran:

        - WebSocket bağlantı durumunu gösterir.
        - Yeni giriş doğrulama isteklerini gösterir.
        - Kullanıcının isteği onaylamasını sağlar.
        - Kullanıcının isteği reddetmesini sağlar.
        - Challenge süresini gösterir.
        - WebSocket bağlantısını yeniden başlatabilir.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="640dp"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!--
            =================================================
            ÜST BAŞLIK ALANI
            =================================================
        -->
        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/headerIconCard"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/headerIconImageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Authenticator uygulama simgesi"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/headerTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Authenticator"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/headerSubtitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Project Management giriş istekleri"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

        </LinearLayout>


        <!--
            =================================================
            BAĞLANTI DURUM KARTI
            =================================================
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/connectionStatusCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <!--
                    Bağlantı durumunu görsel olarak temsil eden
                    gösterge alanıdır.

                    Authenticated durumda yeşil, hata durumunda
                    kırmızı gibi bir tint Activity tarafından
                    uygulanabilir.
                -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/connectionStatusIndicatorCard"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    app:cardCornerRadius="23dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSecondaryContainer">

                    <ImageView
                        android:id="@+id/connectionStatusIconImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="WebSocket bağlantı durumu"
                        android:padding="11dp"
                        android:src="@android:drawable/presence_online"
                        app:tint="?attr/colorOnSecondaryContainer" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/connectionStatusTitleTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bağlantı bekleniyor"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        tools:text="Authenticator aktif" />

                    <TextView
                        android:id="@+id/connectionStatusDescriptionTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Python Authenticator sunucusuna bağlanılmadı."
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Giriş doğrulama istekleri bekleniyor." />

                </LinearLayout>

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/connectionProgressIndicator"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="12dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorSize="30dp"
                    app:trackThickness="3dp"
                    tools:visibility="visible" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!--
            =================================================
            BİLGİ MESAJI
            =================================================
        -->
        <TextView
            android:id="@+id/infoMessageTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/connectionStatusCard"
            tools:text="Authenticator aktif. Giriş istekleri bekleniyor."
            tools:visibility="visible" />


        <!--
            =================================================
            HATA MESAJI
            =================================================
        -->
        <TextView
            android:id="@+id/errorMessageTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#1AFF0000"
            android:gravity="center"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/infoMessageTextView"
            tools:text="WebSocket bağlantısı kurulamadı."
            tools:visibility="visible" />


        <!--
            =================================================
            YENİDEN BAĞLAN BUTONU
            =================================================

            WebSocket bağlantısı kesildiğinde veya hata
            oluştuğunda görünür hâle getirilecektir.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reconnectButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="Yeniden Bağlan"
            android:textAllCaps="false"
            android:visibility="gone"
            app:cornerRadius="16dp"
            app:icon="@android:drawable/ic_popup_sync"
            app:iconGravity="textStart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/errorMessageTextView"
            tools:visibility="visible" />


        <!--
            =================================================
            BEKLEME KARTI
            =================================================

            Aktif challenge bulunmadığında gösterilir.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/waitingCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/reconnectButton">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="34dp"
                android:paddingEnd="24dp"
                android:paddingBottom="34dp">

                <ImageView
                    android:id="@+id/waitingIconImageView"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="Doğrulama isteği bekleniyor"
                    android:padding="14dp"
                    android:src="@android:drawable/ic_lock_idle_lock"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/waitingTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="Giriş isteği bekleniyor"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/waitingDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="Project Management web uygulamasında yeni bir giriş yapılmak istendiğinde doğrulama isteği burada görünecektir."
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/waitingProgressIndicator"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:indeterminate="true"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="5dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!--
            =================================================
            CHALLENGE KARTI
            =================================================

            Yeni challenge geldiğinde görünür yapılır.
            waitingCard ise gizlenir.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/challengeCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/reconnectButton"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!--
                    Challenge üst başlık alanı
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardBackgroundColor="?attr/colorPrimaryContainer"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Yeni giriş isteği"
                            android:padding="11dp"
                            android:src="@android:drawable/ic_dialog_alert"
                            app:tint="?attr/colorOnPrimaryContainer" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/challengeTitleTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Yeni giriş isteği"
                            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/challengeSubtitleTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Bu giriş işlemi size mi ait?"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dismissChallengeButton"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="Doğrulama isteğini kapat"
                        app:icon="@android:drawable/ic_menu_close_clear_cancel"
                        app:iconTint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>


                <!--
                    =================================================
                    KULLANICI BİLGİSİ
                    =================================================
                -->
                <TextView
                    android:id="@+id/userSectionLabelTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="KULLANICI"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/challengeUserNameTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Kullanıcı adı"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    tools:text="Alperen Saraç" />

                <TextView
                    android:id="@+id/challengeEmailTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="alperen@example.com" />


                <!--
                    =================================================
                    İSTEK KAYNAĞI
                    =================================================
                -->
                <TextView
                    android:id="@+id/originSectionLabelTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="İSTEK KAYNAĞI"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/challengeOriginTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Bilinmeyen uygulama"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="react-web" />


                <!--
                    =================================================
                    IP ADRESİ
                    =================================================
                -->
                <TextView
                    android:id="@+id/ipSectionLabelTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="IP ADRESİ"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/challengeIpTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Bilinmiyor"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="10.203.83.58" />


                <!--
                    =================================================
                    TEK KULLANIMLIK KOD
                    =================================================

                    Challenge içinde one_time_code bulunmuyorsa bu
                    alan tamamen gizlenecektir.
                -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/oneTimeCodeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSecondaryContainer"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/oneTimeCodeLabelTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="DOĞRULAMA KODU"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/oneTimeCodeTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:letterSpacing="0.15"
                            android:text="987456"
                            android:textAppearance="@style/TextAppearance.Material3.DisplaySmall"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:textStyle="bold"
                            tools:text="987456" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!--
                    =================================================
                    GERİ SAYIM
                    =================================================
                -->
                <LinearLayout
                    android:id="@+id/countdownContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/countdownIconImageView"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Kalan süre"
                        android:src="@android:drawable/ic_lock_idle_alarm"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/countdownTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Kalan süre: --"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        tools:text="Kalan süre: 42 saniye" />

                </LinearLayout>


                <!--
                    =================================================
                    KARAR İŞLEMİ PROGRESS
                    =================================================
                -->
                <LinearLayout
                    android:id="@+id/decisionLoadingContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/decisionProgressIndicator"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:indeterminate="true"
                        app:indicatorSize="28dp"
                        app:trackThickness="3dp" />

                    <TextView
                        android:id="@+id/decisionLoadingTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Karar gönderiliyor..."
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>


                <!--
                    =================================================
                    ONAYLA VE REDDET BUTONLARI
                    =================================================
                -->
                <LinearLayout
                    android:id="@+id/challengeActionContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rejectChallengeButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Reddet"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorError"
                        android:textStyle="bold"
                        app:cornerRadius="16dp"
                        app:icon="@android:drawable/ic_menu_close_clear_cancel"
                        app:iconGravity="textStart"
                        app:iconTint="?attr/colorError"
                        app:strokeColor="?attr/colorError" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/approveChallengeButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Onayla"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:cornerRadius="16dp"
                        app:icon="@android:drawable/checkbox_on_background"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!--
            =================================================
            ALT GÜVENLİK BİLGİSİ
            =================================================
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/securityInformationCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/challengeCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Güvenlik bilgisi"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_lock_lock"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/securityInformationTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="Yalnızca sizin başlattığınız giriş isteklerini onaylayın. Tanımadığınız istekleri reddedin."
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>