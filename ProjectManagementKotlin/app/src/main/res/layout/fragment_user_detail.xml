<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- ============================================================= -->
    <!-- TOOLBAR                                                       -->
    <!-- ============================================================= -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarUserDetail"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/user_detail_title"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:titleTextColor="?attr/colorOnSurface" />

    <!-- ============================================================= -->
    <!-- CONTENT                                                       -->
    <!-- ============================================================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewUserDetail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarUserDetail">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <!-- ========================================================= -->
            <!-- USER INFO                                                 -->
            <!-- ========================================================= -->

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textViewUserDetailEmailInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- ========================================================= -->
            <!-- LOADING                                                   -->
            <!-- ========================================================= -->

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressIndicatorUserDetail"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:contentDescription="@string/content_description_loading"
                android:visibility="gone"
                app:indicatorSize="40dp"
                app:trackThickness="4dp" />

            <!-- ========================================================= -->
            <!-- FORM                                                      -->
            <!-- ========================================================= -->

            <LinearLayout
                android:id="@+id/layoutUserDetailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- AD -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutUserDetailFirstName"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:hint="@string/create_user_first_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextUserDetailFirstName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="50"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- SOYAD -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutUserDetailLastName"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/create_user_last_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextUserDetailLastName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="50"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- EMAIL -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutUserDetailEmail"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/create_user_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextUserDetailEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:maxLength="200"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ROLE -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutUserDetailRole"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/create_user_role">

                    <AutoCompleteTextView
                        android:id="@+id/autoCompleteUserDetailRole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- DEPARTMENT -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutUserDetailDepartment"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/create_user_department">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextUserDetailDepartment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLength="100"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ===================================================== -->
                <!-- STATUS                                                -->
                <!-- ===================================================== -->

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchUserDetailActive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/user_detail_active" />

                <!-- ===================================================== -->
                <!-- UPDATE                                                -->
                <!-- ===================================================== -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSaveUser"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/user_detail_save" />

                <!-- ===================================================== -->
                <!-- PASSWORD                                              -->
                <!-- ===================================================== -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonResetUserPassword"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/user_detail_reset_password" />

                <!-- ===================================================== -->
                <!-- DELETE                                                -->
                <!-- ===================================================== -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonDeleteUser"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/user_detail_delete"
                    android:textColor="?attr/colorError"
                    app:strokeColor="?attr/colorError" />

                <!-- ===================================================== -->
                <!-- ERROR                                                 -->
                <!-- ===================================================== -->

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textViewUserDetailError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorError"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>