<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- ============================================================= -->
    <!-- TITLE                                                         -->
    <!-- ============================================================= -->

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/textViewProjectsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:text="@string/projects_title"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/buttonCreateProject"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ============================================================= -->
    <!-- ADMIN: CREATE PROJECT                                         -->
    <!-- ============================================================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonCreateProject"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:text="@string/projects_create"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ============================================================= -->
    <!-- SEARCH                                                        -->
    <!-- ============================================================= -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutProjectSearch"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:hint="@string/projects_search"
        app:endIconMode="clear_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewProjectsTitle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextProjectSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- ============================================================= -->
    <!-- STATUS FILTER                                                 -->
    <!-- ============================================================= -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutProjectStatus"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="6dp"
        android:hint="@string/projects_status"
        app:layout_constraintEnd_toStartOf="@id/textInputLayoutProjectArchived"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textInputLayoutProjectSearch">

        <AutoCompleteTextView
            android:id="@+id/autoCompleteProjectStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- ============================================================= -->
    <!-- ARCHIVED FILTER                                               -->
    <!-- ============================================================= -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutProjectArchived"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:hint="@string/projects_archive_filter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/textInputLayoutProjectStatus"
        app:layout_constraintTop_toBottomOf="@id/textInputLayoutProjectSearch">

        <AutoCompleteTextView
            android:id="@+id/autoCompleteProjectArchived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- ============================================================= -->
    <!-- LIST                                                          -->
    <!-- ============================================================= -->

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshProjects"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textInputLayoutProjectStatus">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewProjects"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="16dp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ============================================================= -->
    <!-- LOADING                                                       -->
    <!-- ============================================================= -->

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressIndicatorProjects"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/content_description_loading"
        android:visibility="gone"
        app:indicatorSize="48dp"
        app:layout_constraintBottom_toBottomOf="@id/swipeRefreshProjects"
        app:layout_constraintEnd_toEndOf="@id/swipeRefreshProjects"
        app:layout_constraintStart_toStartOf="@id/swipeRefreshProjects"
        app:layout_constraintTop_toTopOf="@id/swipeRefreshProjects"
        app:trackThickness="4dp" />

    <!-- ============================================================= -->
    <!-- EMPTY                                                         -->
    <!-- ============================================================= -->

    <LinearLayout
        android:id="@+id/layoutProjectsEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/swipeRefreshProjects"
        app:layout_constraintEnd_toEndOf="@id/swipeRefreshProjects"
        app:layout_constraintStart_toStartOf="@id/swipeRefreshProjects"
        app:layout_constraintTop_toTopOf="@id/swipeRefreshProjects">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/projects_empty"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="?attr/colorOnSurface" />

    </LinearLayout>

    <!-- ============================================================= -->
    <!-- ERROR                                                         -->
    <!-- ============================================================= -->

    <LinearLayout
        android:id="@+id/layoutProjectsError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/swipeRefreshProjects"
        app:layout_constraintEnd_toEndOf="@id/swipeRefreshProjects"
        app:layout_constraintStart_toStartOf="@id/swipeRefreshProjects"
        app:layout_constraintTop_toTopOf="@id/swipeRefreshProjects">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/textViewProjectsError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="?attr/colorError" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRetryProjects"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/action_retry" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>