<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Başlık -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/textViewTasksTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/tasks_title"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Arama -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutTaskSearch"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:hint="@string/tasks_search"
        app:endIconMode="clear_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewTasksTitle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextTaskSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Status -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutTaskStatus"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="6dp"
        android:hint="@string/tasks_filter_status"
        app:layout_constraintEnd_toStartOf="@id/textInputLayoutTaskPriority"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textInputLayoutTaskSearch">

        <AutoCompleteTextView
            android:id="@+id/autoCompleteTaskStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Priority -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutTaskPriority"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:hint="@string/tasks_filter_priority"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/textInputLayoutTaskStatus"
        app:layout_constraintTop_toBottomOf="@id/textInputLayoutTaskSearch">

        <AutoCompleteTextView
            android:id="@+id/autoCompleteTaskPriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Overdue -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutTaskOverdue"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:hint="@string/tasks_filter_overdue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textInputLayoutTaskStatus">

        <AutoCompleteTextView
            android:id="@+id/autoCompleteTaskOverdue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Liste -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshTasks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textInputLayoutTaskOverdue">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewTasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="18dp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Loading -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressIndicatorTasks"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/content_description_loading"
        android:visibility="gone"
        app:indicatorSize="48dp"
        app:layout_constraintBottom_toBottomOf="@id/swipeRefreshTasks"
        app:layout_constraintEnd_toEndOf="@id/swipeRefreshTasks"
        app:layout_constraintStart_toStartOf="@id/swipeRefreshTasks"
        app:layout_constraintTop_toTopOf="@id/swipeRefreshTasks"
        app:trackThickness="4dp" />

    <!-- Empty -->
    <LinearLayout
        android:id="@+id/layoutTasksEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/swipeRefreshTasks"
        app:layout_constraintEnd_toEndOf="@id/swipeRefreshTasks"
        app:layout_constraintStart_toStartOf="@id/swipeRefreshTasks"
        app:layout_constraintTop_toTopOf="@id/swipeRefreshTasks">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/tasks_empty"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

    </LinearLayout>

    <!-- Error -->
    <LinearLayout
        android:id="@+id/layoutTasksError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/swipeRefreshTasks"
        app:layout_constraintEnd_toEndOf="@id/swipeRefreshTasks"
        app:layout_constraintStart_toStartOf="@id/swipeRefreshTasks"
        app:layout_constraintTop_toTopOf="@id/swipeRefreshTasks">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/textViewTasksError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="?attr/colorError" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRetryTasks"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/action_retry" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>