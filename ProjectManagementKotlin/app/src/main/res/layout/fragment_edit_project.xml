<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- ============================================================= -->
    <!-- TOOLBAR                                                       -->
    <!-- ============================================================= -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarEditProject"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/edit_project_title">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonEditProjectBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_back" />

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- ============================================================= -->
    <!-- CONTENT                                                       -->
    <!-- ============================================================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollEditProject"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarEditProject">

        <LinearLayout
            android:id="@+id/layoutEditProjectContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp"
            android:visibility="gone">

            <!-- NAME -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutEditProjectName"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/create_project_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextEditProjectName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="200"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- DESCRIPTION -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutEditProjectDescription"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/create_project_description">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextEditProjectDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="5000"
                    android:minLines="4" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- START DATE -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutEditProjectStartDate"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/create_project_start_date">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextEditProjectStartDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- END DATE -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutEditProjectEndDate"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/create_project_end_date">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextEditProjectEndDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- STATUS -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutEditProjectStatus"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/create_project_status">

                <AutoCompleteTextView
                    android:id="@+id/autoCompleteEditProjectStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- OWNER -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutEditProjectOwnerId"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/create_project_owner_id"
                app:helperText="@string/edit_project_owner_helper">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextEditProjectOwnerId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- GENERAL ERROR -->

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textViewEditProjectError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <!-- SAVE -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditProjectSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="@string/edit_project_save" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ============================================================= -->
    <!-- PROGRESS                                                      -->
    <!-- ============================================================= -->

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressIndicatorEditProject"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/content_description_loading"
        app:indicatorSize="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarEditProject"
        app:trackThickness="4dp" />

</androidx.constraintlayout.widget.ConstraintLayout>