<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ============================================================= -->
    <!-- TOOLBAR                                                       -->
    <!-- ============================================================= -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMailbox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:title="@string/mailbox_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ============================================================= -->
    <!-- INBOX / SENT SWITCH                                           -->
    <!-- ============================================================= -->

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleGroupMailboxFolder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:checkedButton="@id/buttonMailboxInbox"
        app:selectionRequired="true"
        app:singleSelection="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarMailbox">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMailboxInbox"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mailbox_inbox" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMailboxSent"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mailbox_sent" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- ============================================================= -->
    <!-- SEARCH                                                        -->
    <!-- ============================================================= -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutMailboxSearch"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:hint="@string/mailbox_search_hint"
        app:endIconMode="clear_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toggleGroupMailboxFolder">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextMailboxSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- ============================================================= -->
    <!-- FILTERS                                                       -->
    <!-- ============================================================= -->

    <LinearLayout
        android:id="@+id/layoutMailboxFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textInputLayoutMailboxSearch">

        <!-- Okundu filtresi -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutMailboxReadFilter"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:hint="@string/mailbox_read_filter">

            <AutoCompleteTextView
                android:id="@+id/autoCompleteMailboxReadFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Attachment filtresi -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutMailboxAttachmentFilter"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:hint="@string/mailbox_attachment_filter">

            <AutoCompleteTextView
                android:id="@+id/autoCompleteMailboxAttachmentFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- ============================================================= -->
    <!-- REFRESH / LIST                                                -->
    <!-- ============================================================= -->

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshMailbox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutMailboxFilters">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewMailbox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="90dp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ============================================================= -->
    <!-- INITIAL LOADING                                               -->
    <!-- ============================================================= -->

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressIndicatorMailbox"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/swipeRefreshMailbox"
        app:layout_constraintEnd_toEndOf="@id/swipeRefreshMailbox"
        app:layout_constraintStart_toStartOf="@id/swipeRefreshMailbox"
        app:layout_constraintTop_toTopOf="@id/swipeRefreshMailbox" />

    <!-- ============================================================= -->
    <!-- EMPTY                                                         -->
    <!-- ============================================================= -->

    <LinearLayout
        android:id="@+id/layoutMailboxEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/swipeRefreshMailbox"
        app:layout_constraintEnd_toEndOf="@id/swipeRefreshMailbox"
        app:layout_constraintStart_toStartOf="@id/swipeRefreshMailbox"
        app:layout_constraintTop_toTopOf="@id/swipeRefreshMailbox">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/textViewMailboxEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mailbox_empty"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/textViewMailboxEmptyDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/mailbox_empty_description"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <!-- ============================================================= -->
    <!-- ERROR                                                         -->
    <!-- ============================================================= -->

    <LinearLayout
        android:id="@+id/layoutMailboxError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/swipeRefreshMailbox"
        app:layout_constraintEnd_toEndOf="@id/swipeRefreshMailbox"
        app:layout_constraintStart_toStartOf="@id/swipeRefreshMailbox"
        app:layout_constraintTop_toTopOf="@id/swipeRefreshMailbox">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/textViewMailboxError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?attr/colorError" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMailboxRetry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/action_retry" />

    </LinearLayout>

    <!-- ============================================================= -->
    <!-- COMPOSE                                                       -->
    <!-- ============================================================= -->

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabMailboxCompose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="@string/mailbox_new_message"
        app:icon="@drawable/ic_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>