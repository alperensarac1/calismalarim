<?xml version="1.0" encoding="utf-8"?>

<!--
    Android 12 ve üzerindeki cihazlarda kullanılan veri çıkarma ve
    cihazlar arası aktarım kurallarıdır.

    Token, kullanıcı ve uygulama verilerinin bulut yedeklerine veya
    cihaz transferine dahil edilmesi engellenir.
-->
<data-extraction-rules>

    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="." />

        <exclude
            domain="database"
            path="." />

        <exclude
            domain="file"
            path="." />

        <exclude
            domain="root"
            path="." />
    </cloud-backup>

    <device-transfer>
        <exclude
            domain="sharedpref"
            path="." />

        <exclude
            domain="database"
            path="." />

        <exclude
            domain="file"
            path="." />

        <exclude
            domain="root"
            path="." />
    </device-transfer>

</data-extraction-rules>