<?xml version="1.0" encoding="utf-8"?>

<!--
    Android 11 ve daha eski cihazlarda kullanılan yedekleme kurallarıdır.

    Uygulama manifestinde allowBackup=false kullanıldığı için yedekleme
    tamamen kapalıdır. Bu dosya ayrıca açık bir güvenlik politikası sağlar.
-->
<full-backup-content>

    <exclude
        domain="sharedpref"
        path="." />

    <exclude
        domain="database"
        path="." />

    <exclude
        domain="file"
        path="." />

    <exclude
        domain="root"
        path="." />

</full-backup-content>