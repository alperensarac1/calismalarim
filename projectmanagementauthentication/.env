APP_NAME=Platform Independent Authenticator Service
APP_VERSION=1.0.0
DEBUG=true

HOST=0.0.0.0
PORT=8090

DATABASE_URL=sqlite:///./data/authenticator.db

SECRET_KEY=BURAYA_YENI_GUCLU_SECRET_KEY_YAZ
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
DEVICE_TOKEN_EXPIRE_DAYS=365

CHALLENGE_EXPIRE_SECONDS=120
CHALLENGE_MAX_ATTEMPTS=5

# React'i localhost ile açıyorsan:
FRONTEND_ORIGIN=http://localhost:5173

# Python -> .NET aynı bilgisayarda:
MAIN_BACKEND_BASE_URL=http://127.0.0.1:8080
MAIN_BACKEND_CURRENT_USER_PATH=/api/Auth/me
MAIN_BACKEND_TIMEOUT_SECONDS=10
VERIFY_BACKEND_ACCESS_TOKEN=true

SERVICE_API_KEY=BURAYA_GUCLU_SERVICE_API_KEY_YAZ

REVERSE_GEOCODING_ENABLED=true
REVERSE_GEOCODING_USER_AGENT=projectmanagement-authenticator/1.0
REVERSE_GEOCODING_TIMEOUT_SECONDS=8
REVERSE_GEOCODING_CACHE_SIZE=500

ENABLE_TEST_CHALLENGE_CODE=true
TEST_CHALLENGE_CODE=987456
ALLOW_CHALLENGE_WITHOUT_DEVICE=true
AUTO_CREATE_EXTERNAL_USER=true